#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../config/tiers.env"

tier="${1:-}"
[[ -n "$tier" ]] || { printf '用法: llm-chat <l1|l2|l3|l3q|l4|l5> [chat 参数...]\n' >&2; exit 2; }
shift
tier="${tier,,}"
var="TIER_${tier}_PORT"
port="${!var:-}"
[[ -n "$port" ]] || { printf '未知层级: %s\n' "$tier" >&2; exit 2; }

keep_running="${LLM_KEEP_RUNNING:-0}"
chat_args=()
for arg in "$@"; do
  if [[ "$arg" == "--keep-running" ]]; then
    keep_running=1
  else
    chat_args+=("$arg")
  fi
done

started_here=0
cleanup() {
  local status=$?
  if (( started_here )) && [[ "$keep_running" != 1 ]]; then
    "$SCRIPT_DIR/llm-down" "$tier" || true
  fi
  exit "$status"
}
trap cleanup EXIT

if ! curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
  "$SCRIPT_DIR/llm-up" "$tier"
  started_here=1
fi

# The vLLM environment is the project's managed Python runtime.
if [[ -x "$(dirname "$VLLM_BIN")/python" ]]; then
  PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" \
    "$(dirname "$VLLM_BIN")/python" "$SCRIPT_DIR/chat" "$tier" "${chat_args[@]}"
else
  printf '找不到 Python 运行环境: %s\n' "$(dirname "$VLLM_BIN")/python" >&2
  exit 1
fi
