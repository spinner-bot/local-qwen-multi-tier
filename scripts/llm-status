#!/usr/bin/env bash
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../config/tiers.env"

get() { local v="TIER_$1_$2"; printf '%s' "${!v:-}"; }

printf '%-4s %-30s %-8s %-6s %-8s %s\n' "级别" "模型" "PID" "端口" "健康" "GPU 分配"
printf '%s\n' "--------------------------------------------------------------------------------"

for tier in $TIERS; do
  name=$(get "$tier" NAME)
  port=$(get "$tier" PORT)
  pidfile="$LLM_RUN/$tier.pid"
  pid="-"
  health="-"
  if [[ -f "$pidfile" ]]; then
    p=$(cat "$pidfile")
    if kill -0 "$p" 2>/dev/null; then
      pid=$p
      if curl -sf "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
        health="ok"
      else
        health="loading"
      fi
    else
      pid="dead"
    fi
  fi
  gpu_file="$LLM_RUN/$tier.gpus"
  if [[ "$pid" =~ ^[0-9]+$ && -r "$gpu_file" ]]; then
    mem="GPU$(cat "$gpu_file")"
  else
    mem="动态分配（未运行）"
  fi
  printf '%-4s %-30s %-8s %-6s %-8s %s\n' "$tier" "$name" "$pid" "$port" "$health" "$mem"
done

printf '\n监听端口：\n'
ss -tln 2>/dev/null | awk '$4 ~ /:(8101|8102|8103|8104|8110)$/ {print "  " $4}'
