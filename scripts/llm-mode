#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../config/tiers.env"

mode="${1:-}"
case "$mode" in
  standard)
    printf '错误: standard 模式会同时运行 L1-L4，不适用于共享服务器。请用 scripts/llm-chat <层级> 按需调用。\n' >&2
    exit 2
    ;;
  flagship)
    printf '模式: flagship（L5 用 %s，其余层级停止）\n' "${LLM_L5_GPUS:-4,5,6,7}"
    for t in l1 l2 l3 l3q l4 l5; do "$SCRIPT_DIR/llm-down" "$t" || true; done
    export LLM_L5_GPUS="${LLM_L5_GPUS:-4,5,6,7}"
    "$SCRIPT_DIR/llm-up" l5
    ;;
  flagship-local)
    printf '模式: flagship-local（L5 用 0,1,2,3，L1-L4 让路）\n'
    for t in l1 l2 l3 l3q l4 l5; do "$SCRIPT_DIR/llm-down" "$t" || true; done
    export LLM_L5_GPUS=0,1,2,3
    "$SCRIPT_DIR/llm-up" l5
    ;;
  quality)
    printf '模式: quality（27B bf16 TP2 占 2,3，其余层级停止）\n'
    for t in l1 l2 l3 l3q l4 l5; do "$SCRIPT_DIR/llm-down" "$t" || true; done
    "$SCRIPT_DIR/llm-up" l3q
    ;;
  standby)
    printf '模式: standby（停止所有服务，保留本地权重）\n'
    for t in l1 l2 l3 l3q l4 l5; do "$SCRIPT_DIR/llm-down" "$t" || true; done
    ;;
  stop)
    printf '停止全部档位\n'
    for t in l1 l2 l3 l3q l4 l5; do "$SCRIPT_DIR/llm-down" "$t" || true; done
    ;;
  status)
    exec "$SCRIPT_DIR/llm-status"
    ;;
  *)
    printf '用法: llm-mode <standby|flagship|flagship-local|quality|stop|status>\n' >&2
    exit 2
    ;;
esac
