#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../config/tiers.env"

die() { printf '错误: %s\n' "$*" >&2; exit 1; }

tier="${1:-}"
[[ -n "$tier" ]] || die "用法: llm-up <l1|l2|l3|l3q|l4|l5> [--allow-busy]"
shift || true
ALLOW_BUSY=0
for arg in "$@"; do
  case "$arg" in
    --allow-busy) ALLOW_BUSY=1 ;;
    *) die "未知参数: $arg" ;;
  esac
done
[[ " $TIERS " == *" $tier "* ]] || die "未知层级: $tier"

get() { local v="TIER_${tier}_$1"; printf '%s' "${!v:-}"; }

NAME=$(get NAME)
MODEL=$(get PATH)
TP=$(get TP)
GPUS=$(get GPUS)
PORT=$(get PORT)
CTX=$(get CTX)
UTIL=$(get UTIL)
MAX_NUM_SEQS=$(get MAX_NUM_SEQS)
USE_FLASHINFER_SAMPLER=$(get USE_FLASHINFER_SAMPLER)

[[ -d "$MODEL" ]] || die "模型目录不存在: $MODEL（先运行 scripts/download-models）"
[[ -f "$MODEL/.download_complete" ]] || die "权重尚未完成本地下载: $MODEL（启动服务不会下载权重；先运行 scripts/download-models）"
compgen -G "$MODEL/*.safetensors" >/dev/null || die "未找到 safetensors: $MODEL"
[[ -x "$VLLM_BIN" ]] || die "vLLM 不可执行: $VLLM_BIN（先安装 vllm 环境）"
export PATH="$(dirname "$VLLM_BIN"):$PATH"

# pip-installed CUDA toolkits place nvcc under site-packages/nvidia/cu*/bin.
# FlashInfer uses it to build sampling kernels on first startup.
if [[ -n "${CUDA_HOME:-}" && -x "$CUDA_HOME/bin/nvcc" ]]; then
  export PATH="$CUDA_HOME/bin:$PATH"
else
  vllm_env="$(cd "$(dirname "$VLLM_BIN")/.." && pwd)"
  for nvcc in "$vllm_env"/lib/python*/site-packages/nvidia/cu*/bin/nvcc; do
    if [[ -x "$nvcc" ]]; then
      export CUDA_HOME="${nvcc%/bin/nvcc}"
      export PATH="$CUDA_HOME/bin:$PATH"
      break
    fi
  done
fi

# Keep startup working on installations without a CUDA compiler. In that case
# use vLLM's native sampler instead of FlashInfer's JIT-compiled sampler.
if ! command -v nvcc >/dev/null 2>&1 && [[ -z "${VLLM_USE_FLASHINFER_SAMPLER:-}" ]]; then
  export VLLM_USE_FLASHINFER_SAMPLER=0
fi
if [[ -n "$USE_FLASHINFER_SAMPLER" && -z "${VLLM_USE_FLASHINFER_SAMPLER:-}" ]]; then
  export VLLM_USE_FLASHINFER_SAMPLER="$USE_FLASHINFER_SAMPLER"
fi

mkdir -p "$LLM_RUN/logs"
PIDFILE="$LLM_RUN/$tier.pid"
LOGFILE="$LLM_RUN/logs/$tier.log"

if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  pid=$(cat "$PIDFILE")
  if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
    printf '%s 已就绪 (PID %s)\n' "$tier" "$pid"
    exit 0
  fi
  printf '%s 正在启动 (PID %s)，等待健康检查\n' "$tier" "$pid"
  for _ in $(seq 1 180); do
    if ! kill -0 "$pid" 2>/dev/null; then
      printf '启动失败，日志尾部：\n' >&2
      tail -40 "$LOGFILE" >&2
      rm -f "$PIDFILE"
      exit 1
    fi
    if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
      printf '%s 就绪: http://127.0.0.1:%s/v1 (PID %s)\n' "$tier" "$PORT" "$pid"
      exit 0
    fi
    sleep 10
  done
  die "等待 $tier 就绪超时，请查看 $LOGFILE"
fi
rm -f "$PIDFILE"

if ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}$"; then
  die "端口 $PORT 已被占用"
fi

IFS=',' read -r -a gpu_list <<< "$GPUS"
(( ${#gpu_list[@]} == TP )) || die "GPU 数(${#gpu_list[@]}) 与 TP($TP) 不匹配"
for g in "${gpu_list[@]}"; do
  used=$(nvidia-smi --id="$g" --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | tr -dc '0-9')
  used=${used:-0}
  compute_apps=$(nvidia-smi --id="$g" --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true)
  if (( ALLOW_BUSY == 0 )) && { (( used > 2000 )) || [[ -n "$compute_apps" ]]; }; then
    printf 'GPU%s 已占用 %s MiB：\n' "$g" "$used" >&2
    [[ -z "$compute_apps" ]] || printf '%s\n' "$compute_apps" >&2
    die "检测到 GPU 计算进程，拒绝共用（确认可共存后加 --allow-busy）"
  fi
done

args=(serve "$MODEL" --served-model-name "$tier" --host 127.0.0.1 --port "$PORT" \
      --tensor-parallel-size "$TP" --max-model-len "$CTX" --gpu-memory-utilization "$UTIL")
if [[ -n "$MAX_NUM_SEQS" ]]; then
  args+=(--max-num-seqs "$MAX_NUM_SEQS")
fi
if [[ -r "$LLM_API_KEY_FILE" ]]; then
  args+=(--api-key "$(cat "$LLM_API_KEY_FILE")")
fi

printf '启动 %s (%s) GPUs=%s TP=%s port=%s ctx=%s util=%s\n' "$tier" "$NAME" "$GPUS" "$TP" "$PORT" "$CTX" "$UTIL"
HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 CUDA_VISIBLE_DEVICES="$GPUS" \
  nohup "$VLLM_BIN" "${args[@]}" > "$LOGFILE" 2>&1 &
printf '%s\n' "$!" > "$PIDFILE"
pid=$(cat "$PIDFILE")

for _ in $(seq 1 180); do
  if ! kill -0 "$pid" 2>/dev/null; then
    printf '启动失败，日志尾部：\n' >&2
    tail -40 "$LOGFILE" >&2
    rm -f "$PIDFILE"
    exit 1
  fi
  if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
    printf '%s 就绪: http://127.0.0.1:%s/v1 (PID %s)\n' "$tier" "$PORT" "$pid"
    exit 0
  fi
  sleep 10
done
printf '等待就绪超时，请查看 %s\n' "$LOGFILE" >&2
exit 1
