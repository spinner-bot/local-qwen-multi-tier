# 分级参数：唯一需要维护的配置文件
LLM_ROOT=/data/Users/zrh
LLM_MODELS=$LLM_ROOT/models
LLM_RUN=$LLM_ROOT/run/llm
LLM_SECRETS=$LLM_ROOT/.secrets

VLLM_BIN=${VLLM_BIN:-$LLM_ROOT/.envs/envs/vllm/bin/vllm}
HF_BIN=${HF_BIN:-$LLM_ROOT/.envs/envs/hf-dl/bin/hf}
LLM_API_KEY_FILE=${LLM_API_KEY_FILE:-$LLM_SECRETS/llm_api_key}

# 下载顺序：先小后大
DOWNLOAD_ORDER=${DOWNLOAD_ORDER:-"l1 l2 l4 l3 l5"}
TIERS="l1 l2 l3 l3q l4 l5"

# ---- L1 极速 ----
TIER_l1_NAME=Qwen3.5-4B
TIER_l1_REPO=Qwen/Qwen3.5-4B
TIER_l1_PATH=$LLM_MODELS/Qwen3.5-4B
TIER_l1_TP=1
TIER_l1_GPUS=${LLM_L1_GPUS:-0}
TIER_l1_PORT=8101
TIER_l1_CTX=32768
TIER_l1_UTIL=0.40
TIER_l1_MAX_NUM_SEQS=${LLM_L1_MAX_NUM_SEQS:-64}
TIER_l1_USE_FLASHINFER_SAMPLER=${LLM_L1_USE_FLASHINFER_SAMPLER:-0}
TIER_l1_SIZE_GB=10

